
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet para iFood, 99Food e licenças -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Permissão para leitura das comandas -->
    <uses-permission
        android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:theme="@style/Theme.DaRoca"
        android:label="Da Roça Entregas"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- Abertura pelo ícone do aplicativo -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Compatibilidade com links daroca:// -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="daroca" />
            </intent-filter>

            <!-- Compatibilidade com links HTTPS antigos -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="stunning-hamster-387b55.netlify.app"
                    android:pathPrefix="/ifood/" />
            </intent-filter>

        </activity>

    </application>

</manifest>
